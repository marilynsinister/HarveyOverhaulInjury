<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GamePath>D:\Games\Steam\steamapps\common\Stardew Valley</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="HarveyOverhaulInjury" HintPath="..\..\bin\Debug\net6.0\HarveyOverhaulInjury.dll" Private="false" />
    <Reference Include="HarveyOverhaulCore" HintPath="..\..\..\HarveyOverhaulCore\bin\Debug\net6.0\HarveyOverhaulCore.dll" Private="false" />
    <Reference Include="Stardew Valley" HintPath="$(GamePath)\Stardew Valley.dll" Private="false" />
    <Reference Include="StardewModdingAPI" HintPath="$(GamePath)\StardewModdingAPI.dll" Private="false" />
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)\MonoGame.Framework.dll" Private="false" />
  </ItemGroup>
</Project>
