{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harvey-overhaul-injury.local/schemas/harvey-injury-test.schema.json",
  "title": "Harvey Overhaul Injury Test Suite",
  "description": "Машиночитаемый формат JSON-сценариев для AI-тестирования мода HarveyOverhaulInjury через StardewMCP, Injury MCP и SMAPI console.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "suiteId",
    "suiteName",
    "description",
    "requires",
    "tests"
  ],
  "properties": {
    "suiteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Уникальный идентификатор набора тестов (kebab-case)."
    },
    "suiteName": {
      "type": "string",
      "minLength": 1,
      "description": "Человекочитаемое название набора."
    },
    "description": {
      "type": "string",
      "description": "Краткое описание области покрытия набора."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stardewMcp",
        "smapiConsole",
        "manualClick",
        "debugCommands"
      ],
      "properties": {
        "stardewMcp": {
          "type": "boolean",
          "description": "Нужен запущенный StardewMCP (user-stardew, порт 24842)."
        },
        "smapiConsole": {
          "type": "boolean",
          "description": "Нужна консоль SMAPI или Injury MCP (user-harvey-injury, порт 24843) для команд injury_*."
        },
        "manualClick": {
          "type": "boolean",
          "description": "Хотя бы один тест в наборе требует ручного клика по NPC или UI."
        },
        "debugCommands": {
          "type": "array",
          "description": "Список debug-команд мода, которые должны быть доступны (например injury_reset).",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "description": "Атомарные тесты: каждый проверяет одну механику.",
      "items": {
        "$ref": "#/$defs/testCase"
      }
    }
  },
  "$defs": {
    "stepType": {
      "type": "string",
      "enum": [
        "smapi_command",
        "stardewmcp",
        "manual",
        "observe",
        "wait",
        "note"
      ],
      "description": "Тип шага сценария."
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "description": "P0 — smoke/blocker, P3 — низкий приоритет."
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/stepType"
        },
        "tool": {
          "type": "string",
          "description": "Имя MCP-инструмента (для type=stardewmcp или injury MCP через smapi_command с server user-harvey-injury)."
        },
        "command": {
          "type": "string",
          "description": "Команда SMAPI без префикса mod (например injury_reset) или строка команды для консоли."
        },
        "args": {
          "type": "object",
          "description": "Аргументы MCP-инструмента или параметры команды.",
          "additionalProperties": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Что делает шаг и зачем он нужен в сценарии."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "smapi_command"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stardewmcp"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "tool"
            ]
          }
        }
      ]
    },
    "cleanupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "smapi_command",
            "stardewmcp",
            "manual",
            "note"
          ]
        },
        "tool": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "additionalProperties": true
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "buffsPresent": {
          "type": "array",
          "description": "ID баффов, которые должны быть активны у игрока.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "buffsAbsent": {
          "type": "array",
          "description": "ID баффов, которых не должно быть.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "topicsPresent": {
          "type": "array",
          "description": "Conversation topics, которые должны быть у игрока.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "topicsAbsent": {
          "type": "array",
          "description": "Topics, которых не должно быть.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "state": {
          "type": "object",
          "description": "Ожидаемые поля состояния мода (MainInjuryId, phase, флаги). Значения — строки, числа или boolean.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "logsContain": {
          "type": "array",
          "description": "Подстроки, которые должны встретиться в SMAPI-логе после шагов.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "logsNotContain": {
          "type": "array",
          "description": "Подстроки, которых не должно быть в SMAPI-логе.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hudContains": {
          "type": "array",
          "description": "Строки в debug HUD (F10) или ответе injury_debug_dump.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "location": {
          "type": "string",
          "description": "Ожидаемая локация игрока (имя как в get_player_info)."
        },
        "notes": {
          "type": "array",
          "description": "Дополнительные текстовые ожидания, не покрытые полями выше.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "mechanics",
        "preconditions",
        "steps",
        "expected",
        "passCriteria",
        "failureHints",
        "cleanup"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HOI-[A-Z0-9-]+$",
          "description": "Уникальный ID теста в проекте (например HOI-SMOKE-001)."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "mechanics": {
          "type": "array",
          "minItems": 1,
          "description": "Теги механик для фильтрации (MainInjury, DirtyWound, phase_treatment, …).",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "description": "Что должно быть истинно до начала теста.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "passCriteria": {
          "type": "array",
          "minItems": 1,
          "description": "Явные условия PASS — AI сверяет с фактическим состоянием.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "failureHints": {
          "type": "array",
          "description": "Подсказки при FAIL: куда смотреть в коде, логе или HUD.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cleanup": {
          "type": "array",
          "minItems": 1,
          "description": "Шаги восстановления изолированного состояния после теста.",
          "items": {
            "$ref": "#/$defs/cleanupStep"
          }
        }
      }
    }
  }
}
