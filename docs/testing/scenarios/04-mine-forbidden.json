          "args": {
            "buff_id": "buffHurt"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Вход в шахту",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "observe",
          "description": "После входа light: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "После входа light: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "После входа light: injury_buff_dump (если команда доступна)",
