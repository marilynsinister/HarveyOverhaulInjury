        ]
      },
      "passCriteria": [
        "Нет Severe warning chain",
        "MineWarningDay не выставлен для buffHurt"
      ],
      "failureHints": [
        "InjurySets.Severe whitelist"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_mine_forbidden_clear",
          "description": "Снять MineForbidden debuff если остался"
        }
      ]
    },
    {
      "id": "HOI-MINE-003",
      "title": "Severe warning не спамится в один день",
      "priority": "P1",
      "mechanics": [
        "MineForbidden",
        "cooldown"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "SendLetters=true для mail asserts",
        "NeedsMineRescueEvent=False после injury_reset"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Severe buffBadlyHurt",
          "args": {
            "buff_id": "buffBadlyHurt"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Первый вход",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "manual",
          "description": "Зафиксировать первый HUD warning"
        },
        {
          "type": "stardewmcp",
          "tool": "teleport_player",
          "description": "Выйти из шахты",
          "args": {
            "location": "Farm"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Повторный вход в тот же день",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "observe",
          "description": "SMAPI log: второй warning не дублируется или HUD не спамится"
        }
      ],
      "expected": {
        "notes": [
          "Второй вход в тот же день — без повторного MineWarningDay increment"
        ]
      },
      "passCriteria": [
        "Warning один раз за день",
        "LastMineSevereWarningDay не меняется повторно"
      ],
      "failureHints": [
        "GameEventHandler / PlayerEventHandler mine warning dedupe"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_mine_forbidden_clear",
          "description": "Снять MineForbidden debuff если остался"
        }
      ]
    },
    {
      "id": "HOI-MINE-004",
      "title": "MineForbidden появляется на следующий день",
      "priority": "P1",
      "mechanics": [
        "MineForbidden"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "SendLetters=true для mail asserts",
        "NeedsMineRescueEvent=False после injury_reset"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Severe buffBadlyHurt",
          "args": {
            "buff_id": "buffBadlyHurt"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Warning day",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "stardewmcp",
          "tool": "advance_day",
          "description": "Сон — DayStarted apply MineForbidden"
        },
        {
          "type": "observe",
          "description": "injury_buff_dump — HarveyMod_MineForbidden",
          "command": "injury_buff_dump"
        },
        {
          "type": "manual",
          "description": "Проверить почту mailHarveyMineForbidden утром"
        }
      ],
      "expected": {
        "buffsPresent": [
          "HarveyMod_MineForbidden"
        ],
        "logsContain": [
          "[Шахта] Наложен дебафф"
        ]
      },
      "passCriteria": [
        "После advance_day: HarveyMod_MineForbidden активен",
        "MineForbiddenAppliedDay=today"
      ],
      "failureHints": [
        "GameEventHandler DayStarted mine forbidden apply",
        "Нужна команда injury_buff_dump"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_mine_forbidden_clear",
          "description": "Снять MineForbidden debuff если остался"
        }
      ]
    },
    {
      "id": "HOI-MINE-005",
      "title": "MineForbidden истекает через MineForbiddenDurationDays",
      "priority": "P2",
      "mechanics": [
        "MineForbidden",
        "expiry"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "SendLetters=true для mail asserts",
        "NeedsMineRescueEvent=False после injury_reset"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Severe buffBadlyHurt",
          "args": {
            "buff_id": "buffBadlyHurt"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Trigger warning",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "note",
          "description": "Повторить advance_day × MineForbiddenDurationDays (default 2) после apply forbidden"
        },
        {
          "type": "stardewmcp",
          "tool": "advance_day",
          "description": "День 1 после forbidden"
        },
        {
          "type": "stardewmcp",
          "tool": "advance_day",
          "description": "День 2 — expiry по config MineForbiddenDurationDays"
        },
        {
          "type": "observe",
          "description": "MineForbidden снят",
          "command": "injury_buff_dump"
        }
      ],
      "expected": {
        "buffsAbsent": [
          "HarveyMod_MineForbidden"
        ],
        "notes": [
          "Срок = MineForbiddenDurationDays из config.json мода (default 2)"
        ]
      },
      "passCriteria": [
        "HarveyMod_MineForbidden снят после N дней",
        "MineForbiddenAppliedDay cleared"
      ],
      "failureHints": [
        "Config MineForbiddenDurationDays",
        "Нужна команда injury_state_dump"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_mine_forbidden_clear",
          "description": "Снять MineForbidden debuff если остался"
        }
      ]
    },
