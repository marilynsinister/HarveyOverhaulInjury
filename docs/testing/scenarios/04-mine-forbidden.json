          "description": "Apply MineForbidden"
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Повторный вход с forbidden",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "note",
          "description": "SMAPI debug console: debug ebi eventHarveyMineInterception (не StardewMCP)"
        },
        {
          "type": "manual",
          "description": "Прогнать cutscene eventHarveyMineInterception — нет black screen / NRE"
        },
        {
          "type": "observe",
          "description": "injury_game_ui_status — управление вернулось",
          "tool": "injury_game_ui_status"
        }
      ],
      "expected": {
        "logsNotContain": [
          "NullReferenceException",
          "black screen"
        ],
        "notes": [
          "Игрок в логичной локации после event",
          "Mine forbidden state не corrupted"
        ]
      },
      "passCriteria": [
        "CP event стартует и завершается",
        "Нет NRE в SMAPI log",
        "Управление вернулось игроку"
      ],
      "failureHints": [
        "debug ebi в SMAPI console",
        "docs/testing/11-hospital-proximity-events-tests.md HOI-CP-004"
      ],
      "cleanup": [
