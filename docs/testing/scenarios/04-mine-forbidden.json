{
  "suiteId": "04-mine-forbidden",
  "suiteName": "Шахта — Severe warning и MineForbidden",
  "description": "Severe mine entry, MineForbidden lifecycle, CP interception regression. Источник: docs/testing/10-mine-passout-tests.md.",
  "requires": {
    "stardewMcp": true,
    "smapiConsole": true,
    "manualClick": true,
    "debugCommands": [
      "injury_reset",
      "injury_debuff_add",
      "injury_phase_list",
      "injury_mine_forbidden_clear"
    ]
  },
  "tests": [
    {
      "id": "HOI-MINE-001",
      "title": "Severe injury — вход в шахту",
      "priority": "P1",
      "mechanics": [
        "MineForbidden",
        "severe_warning"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "SendLetters=true для mail asserts",
        "NeedsMineRescueEvent=False после injury_reset"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Severe main buffBadlyHurt",
          "args": {
            "buff_id": "buffBadlyHurt"
          }
        },
        {
          "type": "observe",
          "description": "До входа в шахту: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "До входа в шахту: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "До входа в шахту: injury_buff_dump (если команда доступна)",
          "command": "injury_buff_dump"
        },
        {
          "type": "stardewmcp",
          "tool": "set_time",
          "description": "10am",
          "args": {
            "time": "10am"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Вход в шахту",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "manual",
          "description": "Дождаться HUD error: серьёзные раны — не идти в шахту"
        },
        {
          "type": "observe",
          "description": "После первого входа: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "После первого входа: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "После первого входа: injury_buff_dump (если команда доступна)",
          "command": "injury_buff_dump"
        }
      ],
      "expected": {
        "logsContain": [
          "[Шахта]",
          "серьёзные раны"
        ],
        "notes": [
          "MineWarningDay=today, LastMineSevereWarningDay=today в injury_state_dump"
        ]
      },
      "passCriteria": [
        "HUD error при первом входе с Severe main",
        "MineWarningDay выставлен"
      ],
      "failureHints": [
        "PlayerEventHandler.TryHandleSevereMineEntry",
        "Нужна команда injury_state_dump"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_mine_forbidden_clear",
          "description": "Снять MineForbidden debuff если остался"
        }
      ]
    },
    {
      "id": "HOI-MINE-002",
      "title": "Light injury — вход в шахту без запрета",
      "priority": "P1",
      "mechanics": [
