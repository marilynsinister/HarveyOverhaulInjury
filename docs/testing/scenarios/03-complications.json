{
  "suiteId": "03-complications",
  "suiteName": "Осложнения InjuryCare",
  "description": "WetBandage, DirtyWound, WetStitches, Neglect, PainFlare, AllergicRash, infection escalation. Источник: docs/testing/09-complication-tests.md.",
  "requires": {
    "stardewMcp": true,
    "smapiConsole": true,
    "manualClick": true,
    "debugCommands": [
      "injury_reset",
      "injury_debuff_add",
      "injury_phase_list",
      "injury_harvey_click",
      "injury_rain_debug",
      "injury_mine_dirty_simulate",
      "injury_run_daily_checks",
      "injury_neglect_set"
    ]
  },
  "tests": [
    {
      "id": "HOI-COMP-001",
      "title": "WetBandage — ручное наложение и лечение",
      "priority": "P1",
      "mechanics": [
        "WetBandage",
        "HarveyMod_WetBandage"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "Injury MCP / SMAPI доступны",
        "StardewMCP user-stardew доступен",
        "Harvey 3+ сердечка"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Main buffDeepCuts (WetBandageSensitive)",
          "args": {
            "buff_id": "buffDeepCuts"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "set_npc_relationship",
          "description": "Harvey 3+ сердечка для диалогов лечения",
          "args": {
            "npc_name": "Harvey",
            "hearts": 3
          }
        },
        {
          "type": "stardewmcp",
          "tool": "set_time",
          "description": "Рабочие часы клиники",
          "args": {
            "time": "10am"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "teleport_player",
          "description": "Телепорт в Hospital к Харви",
          "args": {
            "location": "Hospital",
            "x": 20,
            "y": 5
          }
        },
        {
          "type": "stardewmcp",
          "tool": "get_npc_location",
          "description": "Убедиться что Harvey в той же локации",
          "args": {
            "npc_name": "Harvey"
          }
        },
        {
          "type": "manual",
          "description": "Клик Harvey для StartTreatment (TreatmentStarted=true)"
        },
        {
          "type": "smapi_command",
          "command": "injury_complication_add",
          "description": "Добавить HarveyMod_WetBandage через QA-команду",
          "args": {
            "complication_buff_id": "HarveyMod_WetBandage"
          }
        },
        {
          "type": "observe",
          "description": "После WetBandage add: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "После WetBandage add: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "После WetBandage add: injury_buff_dump (если команда доступна)",
          "command": "injury_buff_dump"
        },
        {
          "type": "manual",
          "description": "Клик Harvey для TreatComplications"
        },
        {
          "type": "observe",
          "description": "После treat complication: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "После treat complication: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "После treat complication: injury_buff_dump (если команда доступна)",
          "command": "injury_buff_dump"
        }
      ],
      "expected": {
        "buffsAbsent": [
          "HarveyMod_WetBandage"
        ],
        "state": {
          "MainInjuryId": "buffDeepCuts"
        },
        "topicsAbsent": [
          "topicHarvey_WetBandage"
        ],
        "notes": [
          "После add: buffsPresent=[HarveyMod_WetBandage], ActiveComplications содержит WetBandage",
          "После treat: complication снята, main buffDeepCuts и лечение не прерваны"
        ]
      },
      "passCriteria": [
        "injury_complication_add HarveyMod_WetBandage ok=yes (не SKIP)",
        "После treat: нет WetBandage buff/topic/state",
        "MainInjuryId=buffDeepCuts сохранён"
      ],
      "failureHints": [
        "Нужна команда injury_state_dump",
        "Нужна команда injury_buff_dump",
        "Нужна команда injury_topic_dump",
        "ComplicationManager — eligibility и эскалация",
        "Нужна команда injury_complication_add"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        }
      ]
    },
