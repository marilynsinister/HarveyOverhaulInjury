{
  "suiteId": "06-hospitalization",
  "suiteName": "Принудительная госпитализация",
  "description": "Hospital hold, bed warp, exit lock, discharge, activities. Источник: docs/testing/11-hospital-proximity-events-tests.md.",
  "requires": {
    "stardewMcp": true,
    "smapiConsole": true,
    "manualClick": true,
    "debugCommands": [
      "injury_reset",
      "injury_debuff_add",
      "injury_phase_list"
    ]
  },
  "tests": [
    {
      "id": "HOI-HOSP-001",
      "title": "Forced hospitalization start",
      "priority": "P0",
      "mechanics": [
        "hospitalization",
        "forced"
      ],
      "preconditions": [
        "ForceHospitalization=true в config",
        "MinHospitalStayMinutes / HospitalBedX/Y записать в журнал"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "smapi_command",
          "command": "injury_topic_add",
          "description": "topicMineInjuryRescue для forced hosp (если injury_topic_add доступен)",
          "args": {
            "topic_id": "topicMineInjuryRescue"
          }
        },
        {
          "type": "note",
          "description": "Если injury_topic_add недоступен — использовать injury_foreign_topic_add topicMineInjuryRescue или pipeline PASSOUT-002"
        },
        {
          "type": "smapi_command",
          "command": "injury_debuff_add",
          "description": "Severe buffBadlyHurt",
          "args": {
            "buff_id": "buffBadlyHurt"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "set_time",
          "description": "10am",
          "args": {
            "time": "10am"
          }
        },
        {
          "type": "stardewmcp",
          "tool": "teleport_player",
          "description": "Вход в Hospital — старт hold",
          "args": {
            "location": "Hospital"
          }
        },
        {
          "type": "observe",
          "description": "injury_hospital_status после входа",
          "command": "injury_hospital_status"
        },
        {
          "type": "observe",
          "description": "Hospital hold: injury_phase_list — MainInjuryId, phases, complications",
          "tool": "injury_phase_list"
        },
        {
          "type": "observe",
          "description": "Hospital hold: injury_state_dump (если команда доступна)",
          "command": "injury_state_dump"
        },
        {
          "type": "observe",
          "description": "Hospital hold: injury_buff_dump (если команда доступна)",
          "command": "injury_buff_dump"
        }
      ],
      "expected": {
        "state": {
          "IsHospitalized": true,
          "HospitalizedInjuryId": "buffBadlyHurt",
          "HospitalizationReason": "mine_rescue"
        },
        "topicsAbsent": [
          "topicMineInjuryRescue"
        ],
        "logsContain": [
          "ПРИНУДИТЕЛЬНАЯ ГОСПИТАЛИЗАЦИЯ"
        ]
      },
      "passCriteria": [
        "IsHospitalized=true",
        "HospitalizationReason=mine_rescue",
        "topicMineInjuryRescue снят"
      ],
      "failureHints": [
        "HospitalizationManager",
        "Нужна команда injury_hospital_status",
        "Нужна команда injury_topic_add"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        },
        {
          "type": "smapi_command",
          "command": "injury_hospital_discharge",
          "description": "Emergency discharge если hold остался (если команда доступна)"
        }
      ]
    },
