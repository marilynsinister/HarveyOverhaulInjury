{
  "suiteId": "08-cp-events",
  "suiteName": "CP cutscenes — debug ebi smoke",
  "description": "Smoke CP InjuryCare events через debug ebi: no black screen, no NRE, control restored. Источник: docs/testing/11-hospital-proximity-events-tests.md, 02-cp-content-inventory.md.",
  "requires": {
    "stardewMcp": true,
    "smapiConsole": true,
    "manualClick": true,
    "debugCommands": [
      "injury_reset",
      "injury_debug_dump",
      "injury_game_ui_status"
    ]
  },
  "tests": [
    {
      "id": "HOI-CP-001",
      "title": "eventHarveyMineRescueDating smoke",
      "priority": "P1",
      "mechanics": [
        "cp_event",
        "eventHarveyMineRescueDating"
      ],
      "preconditions": [
        "Загружен тестовый сейв",
        "Harvey dating/married для dating-specific events (get_npc_info)",
        "SMAPI debug console для debug ebi"
      ],
      "steps": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Изолированный старт"
        },
        {
          "type": "stardewmcp",
          "tool": "warp_to_mine_floor",
          "description": "Warp на локацию event eventHarveyMineRescueDating",
          "args": {
            "floor": 10
          }
        },
        {
          "type": "note",
          "description": "SMAPI debug console (не StardewMCP): debug ebi eventHarveyMineRescueDating"
        },
        {
          "type": "manual",
          "description": "Прогнать cutscene eventHarveyMineRescueDating — дождаться возврата управления, нет чёрного экрана"
        },
        {
          "type": "observe",
          "description": "injury_game_ui_status — event ended, menu closed",
          "tool": "injury_game_ui_status"
        },
        {
          "type": "stardewmcp",
          "tool": "get_player_info",
          "description": "Локация игрока после event"
        },
        {
          "type": "observe",
          "description": "SMAPI log: нет NullReferenceException",
          "command": "injury_debug_dump"
        },
        {
          "type": "observe",
          "description": "Topics/buffs после event",
          "command": "injury_topic_dump"
        },
        {
          "type": "observe",
          "description": "Buffs после event",
          "command": "injury_buff_dump"
        }
      ],
      "expected": {
        "logsNotContain": [
          "NullReferenceException",
          "Game crashed"
        ],
        "notes": [
          "Cutscene завершилась — управление игроку",
          "Нет зависшего чёрного экрана (esc + log если FAIL)",
          "Dating/married Harvey required"
        ],
        "topicsPresent": [
          "topicMineInjuryRescue"
        ],
        "buffsPresent": [
          "buffBadlyHurt"
        ]
      },
      "passCriteria": [
        "debug ebi eventHarveyMineRescueDating стартует без exception",
        "Нет чёрного экрана / NRE в SMAPI log",
        "Управление вернулось игроку после cutscene",
        "Игрок в логичной локации (обычно Hospital для rescue)"
      ],
      "failureHints": [
        "CP event eventHarveyMineRescueDating — docs/testing/02-cp-content-inventory.md",
        "docs/events-inventory/01-cp-events-catalog.md",
        "injury_game_ui_end_event в Injury MCP если зависло",
        "Нужна команда injury_topic_dump"
      ],
      "cleanup": [
        {
          "type": "smapi_command",
          "command": "injury_reset",
          "description": "Гарантированный сброс injury_reset после теста"
        }
      ]
    },
